<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Child of kernel-ref-parent. MOSIP and clamav-client pins live in kernel/pom.xml.
		This pom declares module dependencies and the fat-JAR assembly.
		Do not import kernel-bom.
	-->
	<parent>
		<groupId>io.mosip.kernel</groupId>
		<artifactId>kernel-ref-parent</artifactId>
		<version>1.4.1-SNAPSHOT</version>
	</parent>

	<artifactId>kernel-virusscanner-clamav</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<name>kernel-virusscanner-clamav</name>
	<description>
		Reference VirusScanner SPI (Boolean / InputStream) using ClamAV via
		xyz.capybara clamav-client. VirusScannerImpl connects lazily to
		mosip.kernel.virus-scanner.host and mosip.kernel.virus-scanner.port;
		scan returns true on ScanResult.OK and false on VirusFound. Unreachable
		daemon or missing files throw VirusScannerException. Auto-loaded via
		META-INF/spring.factories. kernel-core supplies logging; do not add
		kernel-logger-logback. clamav-client version is pinned on
		kernel-ref-parent. Module description lives in this pom, not in
		README.md or AGENTS.md. Fat JAR (assembly jar-with-dependencies,
		appendAssemblyId false) for drop-in on the consumer classpath.
		Another AV: see docs/av.md.
	</description>
	<url>https://github.com/mosip/mosip-ref-impl</url>

	<dependencies>
		<!-- kernel-core: SPI + logging (commons). Version from parent ${kernel.core.version}. -->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!-- clamav-client: ClamAV daemon client. Version from parent ${clamav.client.version}. License: MIT. -->
		<dependency>
			<groupId>xyz.capybara</groupId>
			<artifactId>clamav-client</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Fat JAR for drop-in on the consumer classpath (no classifier). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>${maven.assembly.plugin.version}</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
