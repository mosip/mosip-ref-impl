<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Child of kernel-ref-parent. MOSIP and third-party pins live in kernel/pom.xml.
		This pom declares module dependencies and surefire enable-preview.
		Do not import kernel-bom.
	-->
	<parent>
		<groupId>io.mosip.kernel</groupId>
		<artifactId>kernel-ref-parent</artifactId>
		<version>1.4.1-SNAPSHOT</version>
	</parent>

	<artifactId>kernel-ref-idobjectvalidator</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<name>kernel-ref-idobjectvalidator</name>
	<description>
		Reference IdObjectValidator: identity JSON vs schema and masterdata
		(documents, locations, gender, languages). IdObjectReferenceValidator
		queries identity with json-path / json-smart, caches masterdata in
		commons-collections4 multi-maps, and refreshes via
		mosip.idobjectvalidator.masterdata.rest.uri,
		mosip.idobjectvalidator.scheduler.reset-cache.cron-job-pattern, and
		mosip.idobjectvalidator.refresh-cache-on-unknown-value. Also uses
		mosip.mandatory-languages, mosip.optional-languages, and
		mosip.kernel.idobjectvalidator identity path / date-format keys.
		Tests require surefire --enable-preview. kernel-core (commons) supplies
		logging; do not add kernel-logger-logback. Versions from parent
		kernel-ref-parent; module description lives in this pom, not in
		README.md or AGENTS.md. spring-boot-starter-web (RestTemplate) and
		Spring Cloud config/bootstrap are declared here. Drop the JAR onto
		booking / registration-client.
	</description>
	<url>https://github.com/mosip/mosip-ref-impl</url>

	<dependencies>
		<!--
			kernel-core: SPI + logging (commons). Version from parent ${kernel.core.version}.
			Do not add kernel-logger-logback.
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-core</artifactId>
		</dependency>
		<!--
			commons-collections4: Multi-valued maps for masterdata caches. Version from parent.
		-->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-collections4</artifactId>
		</dependency>
		<!--
			json-path: identity JSON queries. Version from parent ${json-path.version}.
		-->
		<dependency>
			<groupId>com.jayway.jsonpath</groupId>
			<artifactId>json-path</artifactId>
		</dependency>
		<!--
			json-smart: JSONArray (net.minidev.json). Version from parent ${json-smart.version}.
		-->
		<dependency>
			<groupId>net.minidev</groupId>
			<artifactId>json-smart</artifactId>
		</dependency>
		<!--
			spring-boot-starter-web: RestTemplate / web types used by masterdata lookups.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			spring-cloud-starter-config / bootstrap: optional Cloud Config when used as a service lib.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-bootstrap</artifactId>
		</dependency>
		<!--
			mockito-core: Unit tests. Scope: test.
		-->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			byte-buddy: Mockito/inline mocks on JDK 21. Version from Boot parent.
		-->
		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy</artifactId>
		</dependency>
	</dependencies>

	<build>
		<!--
			Parent plugins: surefire enable-preview is required (id-object JSONPath / preview APIs).
		-->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} --add-opens java.xml/jdk.xml.internal=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-preview</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
