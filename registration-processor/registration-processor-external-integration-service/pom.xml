<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Child of registration-processor-ref-parent. MOSIP and third-party pins live in
		registration-processor/pom.xml. This pom declares module dependencies.
		Do not import kernel-bom. No pre-processor parent.
	-->
	<parent>
		<groupId>io.mosip.registrationprocessor</groupId>
		<artifactId>registration-processor-ref-parent</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>registration-processor-external-integration-service</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<name>registration-processor-external-integration-service</name>
	<description>
		Country External Integration Service stub (Boot web). ExternalController
		POST /registration-processor/external-integration-service/v1.0 returns HTTP 200
		true when MessageRequestDTO.request is non-null, otherwise false. Replace the
		controller body with country-specific logic. bootstrap.properties sets
		server.servlet.path=/registrationprocessor/v1/eis. Swagger UI Authorize is an
		Authorization header apiKey (SwaggerConfig, OpenApiProperties, springdoc;
		openapi.* keys). spring-boot-starter-webmvc-test supplies Boot 4 @WebMvcTest.
		Actuator exposes info, health, refresh; git metadata from service-git.properties.
		Logging via kernel-core (transitive); do not add kernel-logger-logback. Versions
		from parent registration-processor-ref-parent; module description lives in this
		pom, not in README.md or AGENTS.md.
	</description>
	<url>https://github.com/mosip/mosip-ref-impl</url>

	<dependencies>
		<!--
			spring-boot-starter-web: EIS stub REST (ExternalController). Version from Boot parent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			spring-boot-starter-actuator: health/info/refresh.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
			spring-cloud-starter-config / bootstrap: registration-processor-default.properties.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-bootstrap</artifactId>
		</dependency>
		<!--
			micrometer-core / prometheus: Actuator metrics.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!--
			springdoc-openapi-starter-webmvc-ui: Swagger UI + Authorize. Version from parent ${springdoc.version}.
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>
		<!--
			spring-boot-configuration-processor: metadata for openapi.* / EIS properties. Optional.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
		<!--
			spring-boot-starter-webmvc-test: Boot 4 MockMvc / @WebMvcTest (not in starter-test).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			mockito-core / junit: JUnit 4 EIS tests. Scope: test.
		-->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
