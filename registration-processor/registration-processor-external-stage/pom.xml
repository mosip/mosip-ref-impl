<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Child of registration-processor-ref-parent. MOSIP and third-party pins live in
		registration-processor/pom.xml. This pom declares module dependencies.
		Do not import kernel-bom. No pre-processor parent.
	-->
	<parent>
		<groupId>io.mosip.registrationprocessor</groupId>
		<artifactId>registration-processor-ref-parent</artifactId>
		<version>1.4.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>registration-processor-external-stage</artifactId>
	<version>1.4.1-SNAPSHOT</version>
	<name>registration-processor-external-stage</name>
	<description>
		Vert.x registration-processor stage. ExternalStage extends MosipVerticleAPIManager:
		consumes EXTERNAL_STAGE_BUS_IN, POSTs registration ids to EIS (ApiName.EISERVICE)
		via registration-processor-rest-client, updates status through
		registration-processor-registration-status-service-impl, then emits
		EXTERNAL_STAGE_BUS_OUT. Property prefix mosip.regproc.external. (message
		expiry-time-limit, eventbus kafka commit/poll/group, eventbus port, server port,
		servlet path). bootstrap.properties sets eventbus.port, server.port, and
		server.servlet.path=/registrationprocessor/v1/external. kernel-auth-adapter is
		packaged in the Boot JAR (no container wget). Logging via kernel-core; do not
		add kernel-logger-logback. Versions from parent registration-processor-ref-parent;
		module description lives in this pom, not in README.md or AGENTS.md. Git info:
		service-git.properties. Needs registration-processor-core, status-service-impl,
		and rest-client SNAPSHOTs on the classpath.
	</description>
	<url>https://github.com/mosip/mosip-ref-impl</url>

	<dependencies>
		<!--
			spring-boot-starter: Vert.x stage Spring context. Version from Boot parent.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<!--
			spring-cloud-starter-config / bootstrap: registration-processor-default.properties.
		-->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-bootstrap</artifactId>
		</dependency>
		<!--
			spring-context: AnnotationConfigApplicationContext in ExternalStageApplication.
		-->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>
		<!--
			registration-processor-core: Vert.x stage base. Version from parent ${registration.processor.core.version}.
		-->
		<dependency>
			<groupId>io.mosip.registrationprocessor</groupId>
			<artifactId>registration-processor-core</artifactId>
		</dependency>
		<!--
			registration-processor-registration-status-service-impl: status updates after EIS POST.
		-->
		<dependency>
			<groupId>io.mosip.registrationprocessor</groupId>
			<artifactId>registration-processor-registration-status-service-impl</artifactId>
		</dependency>
		<!--
			registration-processor-rest-client: HTTP client used to call EISERVICE.
		-->
		<dependency>
			<groupId>io.mosip.registrationprocessor</groupId>
			<artifactId>registration-processor-rest-client</artifactId>
		</dependency>
		<!--
			kernel-auth-adapter: packaged in the JAR (no iam_adapter_url wget).
		-->
		<dependency>
			<groupId>io.mosip.kernel</groupId>
			<artifactId>kernel-auth-adapter</artifactId>
		</dependency>
		<!--
			javax.inject: JSR-330 @Inject used by MOSIP Vert.x stages.
		-->
		<dependency>
			<groupId>javax.inject</groupId>
			<artifactId>javax.inject</artifactId>
		</dependency>
		<!--
			micrometer-core / prometheus: metrics. Versions from Boot parent.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!--
			h2: In-memory DB for status-service tests.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
		</dependency>
		<!--
			mockito-core / vertx-unit: Vert.x + JUnit 4 stage tests. vertx-unit from parent ${vertx.version}.
		-->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.vertx</groupId>
			<artifactId>vertx-unit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
